# 可选：把多个逻辑素材区放入同一私有 COS 桶，映射/数据库仍保存原对象名。
RESOURCE_COS_PREFIX=
IMAGE_COS_PREFIX=
SOFTWARE_COS_PREFIX=
VIDEO_COS_PREFIX=
GIF_COS_PREFIX=
VIDEO_COVER_COS_PREFIX=
GIF_COVER_COS_PREFIX=
# 可选：腾讯云 CDN Type-A 签名下载；留空则继续返回 COS 预签名 URL。
MATERIAL_CDN_BASE_URL=
MATERIAL_CDN_AUTH_KEY=change_this_cdn_auth_key
MATERIAL_CDN_SIGN_PARAM=sign
JWT_SECRET=change_this_to_long_random_string
# API 请求签名（HMAC）；与前端 VITE_API_SIGN_SECRET 保持一致
# 注意：浏览器变量会被打包到前端，请求签名只用于抑制低成本滥用，不能代替 JWT/设备授权。
API_SIGN_SECRET=change_this_to_long_random_api_sign_secret
API_SIGN_MAX_SKEW_SEC=600
API_SIGN_REQUIRED=true
# 防止重放用的 nonce 内存缓存上限（1000~1000000）
API_SIGN_NONCE_CACHE_MAX=100000
TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_TOKEN_PER_MIN=10
AI_RATE_LIMIT_IP_PER_MIN=30
MESSAGE_RATE_LIMIT_TOKEN_PER_MIN=5
MESSAGE_RATE_LIMIT_IP_PER_MIN=15
LIKE_RATE_LIMIT_TOKEN_PER_MIN=30
LIKE_RATE_LIMIT_IP_PER_MIN=60
ACTIVITY_RATE_LIMIT_TOKEN_PER_MIN=8
ACTIVITY_RATE_LIMIT_IP_PER_MIN=20
ADMIN_RATE_LIMIT_IP_PER_MIN=120
# 异常读取 / 下载 / 高频防护（每分钟阈值，超限临时封禁 IP）
# 临时关闭全部 API 限流：API_RATE_LIMIT_ENABLED=false（含 AbuseGuard 与每设备下载次数）
# 生产建议略宽松，避免正常刷图/多标签页误触；可按流量再调
API_RATE_LIMIT_ENABLED=true
ABUSE_GUARD_ENABLED=true
MAX_DOWNLOADS_PER_HOUR=50
MAX_DOWNLOADS_PER_DAY=100
GLOBAL_API_RATE_LIMIT_IP_PER_MIN=624
READ_RATE_LIMIT_IP_PER_MIN=234
DOWNLOAD_SIGN_RATE_LIMIT_TOKEN_PER_MIN=104
DOWNLOAD_SIGN_RATE_LIMIT_IP_PER_MIN=208
INVALID_TOKEN_RATE_LIMIT_IP_PER_MIN=117
NOT_FOUND_SCAN_LIMIT_IP_PER_MIN=65
ABUSE_BLOCK_DURATION_MIN=10
ALLOWED_DEVICES=0483:66AA,0483:66AB,2E3C:5753
ALLOWED_VID=0483
ALLOWED_PID=66AA
# 多个站点用逗号分隔；生产环境不要使用 *
CORS_ALLOW_ORIGIN=https://your-frontend.example.com
# HTTP 服务器超时、请求头上限与优雅退出
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=32768
HTTP_SHUTDOWN_TIMEOUT=20s
RESOURCE_MAP_PATH=config/resource_map.json
IMAGE_MAP_PATH=config/image_map.json
RESOURCE_LIKES_PATH=config/resource_likes.json
RESOURCE_FAVORITES_PATH=config/resource_favorites.json
FOLLOWED_UPLOADERS_PATH=config/followed_uploaders.json
RESOURCE_DOWNLOADS_PATH=config/resource_downloads.json
# 用户数据存储：json（默认）或 mysql
STORAGE_BACKEND=json
MYSQL_DSN=jiadian:change_me@tcp(127.0.0.1:3306)/jiadian_hub?charset=utf8mb4&parseTime=true&loc=Local
MYSQL_SCHEMA_PATH=schema.sql
# 首次迁移时设为 1，启动时把 JSON 导入 MySQL（导入后改回 0）
