PORT=8080
# 可选完整监听地址；生产直连 HTTPS 使用 0.0.0.0:8080，本地可使用 127.0.0.1:8080
LISTEN_ADDR=127.0.0.1:8080
# 两项同时配置时启用 Go 原生 HTTPS；均留空时继续使用 HTTP
TLS_CERT_FILE=
TLS_KEY_FILE=
COS_BUCKET=v1zip-1311844229
COS_REGION=ap-guangzhou
COS_SECRET_ID=change_this_tencent_secret_id
COS_SECRET_KEY=change_this_tencent_secret_key
IMAGE_COS_BUCKET=v1image-1311844229
IMAGE_COS_REGION=ap-guangzhou
IMAGE_COS_SECRET_ID=change_this_tencent_secret_id
IMAGE_COS_SECRET_KEY=change_this_tencent_secret_key
IMAGE_COS_PUBLIC_BASE=https://v1image-1311844229.cos.ap-guangzhou.myqcloud.com
SOFTWARE_COS_BUCKET=v1pro-1311844229
SOFTWARE_COS_REGION=ap-guangzhou
SOFTWARE_COS_SECRET_ID=change_this_tencent_secret_id
SOFTWARE_COS_SECRET_KEY=change_this_tencent_secret_key
SOFTWARE_COS_PUBLIC_BASE=https://v1pro-1311844229.cos.ap-guangzhou.myqcloud.com
VIDEO_COS_BUCKET=video-1311844229
VIDEO_COS_REGION=ap-guangzhou
VIDEO_COS_SECRET_ID=change_this_tencent_secret_id
VIDEO_COS_SECRET_KEY=change_this_tencent_secret_key
GIF_COS_BUCKET=gif-1311844229
GIF_COS_REGION=ap-guangzhou
GIF_COS_SECRET_ID=change_this_tencent_secret_id
GIF_COS_SECRET_KEY=change_this_tencent_secret_key
VIDEO_COVER_COS_BUCKET=video-cover-1311844229
VIDEO_COVER_COS_REGION=ap-guangzhou
VIDEO_COVER_COS_SECRET_ID=change_this_tencent_secret_id
VIDEO_COVER_COS_SECRET_KEY=change_this_tencent_secret_key
GIF_COVER_COS_BUCKET=gif-cover-1311844229
GIF_COVER_COS_REGION=ap-guangzhou
GIF_COVER_COS_SECRET_ID=change_this_tencent_secret_id
GIF_COVER_COS_SECRET_KEY=change_this_tencent_secret_key
# 可选：把多个逻辑素材区放入同一私有 COS 桶，映射/数据库仍保存原对象名。
RESOURCE_COS_PREFIX=
IMAGE_COS_PREFIX=
SOFTWARE_COS_PREFIX=
VIDEO_COS_PREFIX=
GIF_COS_PREFIX=
VIDEO_COVER_COS_PREFIX=
GIF_COVER_COS_PREFIX=
# 可选：腾讯云 CDN Type-A 签名下载；留空则继续返回 COS 预签名 URL。
MATERIAL_CDN_BASE_URL=
MATERIAL_CDN_AUTH_KEY=change_this_cdn_auth_key
MATERIAL_CDN_SIGN_PARAM=sign
JWT_SECRET=change_this_to_long_random_string
# API 请求签名（HMAC）；与前端 VITE_API_SIGN_SECRET 保持一致
# 注意：浏览器变量会被打包到前端，请求签名只用于抑制低成本滥用，不能代替 JWT/设备授权。
API_SIGN_SECRET=change_this_to_long_random_api_sign_secret
API_SIGN_MAX_SKEW_SEC=600
API_SIGN_REQUIRED=true
# 防止重放用的 nonce 内存缓存上限（1000~1000000）
API_SIGN_NONCE_CACHE_MAX=100000
TOKEN_TTL_DAYS=30
DEVICE_FEATURE_ACTIVATION_CODE=1234
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_TOKEN_PER_MIN=10
AI_RATE_LIMIT_IP_PER_MIN=30
MESSAGE_RATE_LIMIT_TOKEN_PER_MIN=5
MESSAGE_RATE_LIMIT_IP_PER_MIN=15
LIKE_RATE_LIMIT_TOKEN_PER_MIN=30
LIKE_RATE_LIMIT_IP_PER_MIN=60
ACTIVITY_RATE_LIMIT_TOKEN_PER_MIN=8
ACTIVITY_RATE_LIMIT_IP_PER_MIN=20
ADMIN_RATE_LIMIT_IP_PER_MIN=120
# 异常读取 / 下载 / 高频防护（每分钟阈值，超限临时封禁 IP）
# 临时关闭全部 API 限流：API_RATE_LIMIT_ENABLED=false（含 AbuseGuard 与每设备下载次数）
# 生产建议略宽松，避免正常刷图/多标签页误触；可按流量再调
API_RATE_LIMIT_ENABLED=true
ABUSE_GUARD_ENABLED=true
MAX_DOWNLOADS_PER_HOUR=50
MAX_DOWNLOADS_PER_DAY=100
GLOBAL_API_RATE_LIMIT_IP_PER_MIN=624
READ_RATE_LIMIT_IP_PER_MIN=234
DOWNLOAD_SIGN_RATE_LIMIT_TOKEN_PER_MIN=104
DOWNLOAD_SIGN_RATE_LIMIT_IP_PER_MIN=208
INVALID_TOKEN_RATE_LIMIT_IP_PER_MIN=117
NOT_FOUND_SCAN_LIMIT_IP_PER_MIN=65
ABUSE_BLOCK_DURATION_MIN=10
ALLOWED_DEVICES=0483:66AA,0483:66AB,2E3C:5753
ALLOWED_VID=0483
ALLOWED_PID=66AA
# 多个站点用逗号分隔；生产环境不要使用 *
CORS_ALLOW_ORIGIN=https://your-frontend.example.com

# 实物商城微信支付 API v3。只有 WECHAT_PAY_ENABLED=true 时才会启用在线收款。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_CERT_SERIAL=
WECHAT_PAY_API_V3_KEY=
# 私钥和平台公钥建议通过只读文件挂载；也可改用对应的 *_PEM 环境变量（支持字面量 \n）。
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/etc/jiadian/wechatpay/apiclient_key.pem
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PEM=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=/etc/jiadian/wechatpay/wechatpay_public_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=
# 必须是公网 HTTPS 地址，并在 API 请求签名中排除；代码已内置回调验签和 AES-GCM 解密。
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/mall/payments/wechat/notify
WECHAT_PAY_EXPIRE=15m
# 后台自动查单并关闭过期订单，安全释放锁定库存。
WECHAT_PAY_RECONCILE_INTERVAL=1m
# H5 支付需在微信商户平台单独开通并配置支付域名；关闭时仍可使用 Native 扫码支付。
WECHAT_PAY_H5_ENABLED=false
WECHAT_PAY_H5_APP_NAME=佳点电子实物商城
WECHAT_PAY_H5_APP_URL=https://www.jadot.cn/#/mall
# 仅用于本地联调测试，生产留空。
WECHAT_PAY_API_BASE=
# HTTP 服务器超时、请求头上限与优雅退出
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=32768
HTTP_SHUTDOWN_TIMEOUT=20s
RESOURCE_MAP_PATH=config/resource_map.json
IMAGE_MAP_PATH=config/image_map.json
RESOURCE_LIKES_PATH=config/resource_likes.json
RESOURCE_FAVORITES_PATH=config/resource_favorites.json
FOLLOWED_UPLOADERS_PATH=config/followed_uploaders.json
# 管理员全局上传封禁（JSON 后端；MySQL 后端使用 upload_bans 表）
UPLOAD_BANS_PATH=config/upload_bans.json
RESOURCE_DOWNLOADS_PATH=config/resource_downloads.json
# 用户数据存储：json（默认）或 mysql
STORAGE_BACKEND=json
MYSQL_DSN=jiadian:change_me@tcp(127.0.0.1:3306)/jiadian_hub?charset=utf8mb4&parseTime=true&loc=Local
MYSQL_SCHEMA_PATH=schema.sql
# 首次迁移时设为 1，启动时把 JSON 导入 MySQL（导入后改回 0）
MYSQL_IMPORT_JSON=0
AI_IMAGE_SHARES_PATH=config/ai_image_share_counts.json
RESOURCES_PATH=../src/data/resources.json
COLUMN_TAGS_PATH=../src/data/columnTags.json
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=image-01
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_GROUP_ID=
IMS_SECRET_ID=
IMS_SECRET_KEY=
IMS_REGION=ap-guangzhou
IMS_BIZ_TYPE=
IMS_AIGC_MODERATION_TYPE=IMAGE_AIGC
IMS_GIF_INTERVAL=5
IMS_GIF_MAX_FRAMES=5
IMS_ENABLED=true
REVIEW_ADMIN_TOKEN=change_this_review_admin_token
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change_this_admin_password
IMAGE_REVIEW_QUEUE_PATH=config/image_review_queue.json
